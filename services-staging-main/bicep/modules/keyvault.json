{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "metadata": {
    "_generator": {
      "name": "bicep",
      "version": "0.42.1.51946",
      "templateHash": "14969792505839089598"
    }
  },
  "parameters": {
    "serviceName": {
      "type": "string",
      "metadata": {
        "description": "Name prefix for new Key Vault (ignored if existingName provided)"
      }
    },
    "location": {
      "type": "string",
      "metadata": {
        "description": "Azure region"
      }
    },
    "tags": {
      "type": "object",
      "defaultValue": {},
      "metadata": {
        "description": "Resource tags"
      }
    },
    "identityPrincipalId": {
      "type": "string",
      "metadata": {
        "description": "Managed identity principal ID for access policy"
      }
    },
    "tenantId": {
      "type": "string",
      "defaultValue": "[subscription().tenantId]",
      "metadata": {
        "description": "Key Vault tenant ID (defaults to current subscription tenant)"
      }
    },
    "existingName": {
      "type": "string",
      "defaultValue": "",
      "metadata": {
        "description": "Name of an existing Key Vault to use (empty = create new)"
      }
    },
    "softDeleteRetentionInDays": {
      "type": "int",
      "defaultValue": 90,
      "minValue": 7,
      "maxValue": 90,
      "metadata": {
        "description": "Soft-delete retention in days (7-90)"
      }
    },
    "enablePurgeProtection": {
      "type": "bool",
      "defaultValue": false,
      "metadata": {
        "description": "Enable purge protection. IRREVERSIBLE once set to true."
      }
    },
    "disablePublicNetworkAccess": {
      "type": "bool",
      "defaultValue": true,
      "metadata": {
        "description": "Disable public network access (recommended when fronted by a private endpoint)"
      }
    },
    "secrets": {
      "type": "secureObject",
      "defaultValue": {},
      "metadata": {
        "description": "Secrets to create as name/value pairs"
      }
    }
  },
  "variables": {
    "createNew": "[empty(parameters('existingName'))]",
    "kvName": "[if(variables('createNew'), format('kv-{0}-{1}', parameters('serviceName'), uniqueString(resourceGroup().id)), parameters('existingName'))]",
    "identityAccessPolicy": {
      "tenantId": "[parameters('tenantId')]",
      "objectId": "[parameters('identityPrincipalId')]",
      "permissions": {
        "secrets": [
          "get",
          "list",
          "set",
          "delete"
        ]
      }
    }
  },
  "resources": [
    {
      "condition": "[variables('createNew')]",
      "type": "Microsoft.KeyVault/vaults",
      "apiVersion": "2023-07-01",
      "name": "[variables('kvName')]",
      "location": "[parameters('location')]",
      "tags": "[parameters('tags')]",
      "properties": {
        "sku": {
          "family": "A",
          "name": "standard"
        },
        "tenantId": "[parameters('tenantId')]",
        "enableRbacAuthorization": false,
        "enableSoftDelete": true,
        "softDeleteRetentionInDays": "[parameters('softDeleteRetentionInDays')]",
        "enablePurgeProtection": "[parameters('enablePurgeProtection')]",
        "publicNetworkAccess": "[if(parameters('disablePublicNetworkAccess'), 'Disabled', 'Enabled')]",
        "networkAcls": {
          "defaultAction": "[if(parameters('disablePublicNetworkAccess'), 'Deny', 'Allow')]",
          "bypass": "AzureServices",
          "ipRules": [],
          "virtualNetworkRules": []
        },
        "accessPolicies": [
          "[variables('identityAccessPolicy')]"
        ]
      }
    },
    {
      "condition": "[not(variables('createNew'))]",
      "type": "Microsoft.KeyVault/vaults/accessPolicies",
      "apiVersion": "2023-07-01",
      "name": "[format('{0}/{1}', parameters('existingName'), 'add')]",
      "properties": {
        "accessPolicies": [
          "[variables('identityAccessPolicy')]"
        ]
      }
    },
    {
      "copy": {
        "name": "kvSecretsNew",
        "count": "[length(objectKeys(parameters('secrets')))]"
      },
      "condition": "[variables('createNew')]",
      "type": "Microsoft.KeyVault/vaults/secrets",
      "apiVersion": "2023-07-01",
      "name": "[format('{0}/{1}', variables('kvName'), objectKeys(parameters('secrets'))[copyIndex()])]",
      "properties": {
        "value": "[parameters('secrets')[objectKeys(parameters('secrets'))[copyIndex()]]]"
      },
      "dependsOn": [
        "[resourceId('Microsoft.KeyVault/vaults', variables('kvName'))]"
      ]
    },
    {
      "copy": {
        "name": "kvSecretsExisting",
        "count": "[length(objectKeys(parameters('secrets')))]"
      },
      "condition": "[not(variables('createNew'))]",
      "type": "Microsoft.KeyVault/vaults/secrets",
      "apiVersion": "2023-07-01",
      "name": "[format('{0}/{1}', parameters('existingName'), objectKeys(parameters('secrets'))[copyIndex()])]",
      "properties": {
        "value": "[parameters('secrets')[objectKeys(parameters('secrets'))[copyIndex()]]]"
      }
    }
  ],
  "outputs": {
    "keyVaultName": {
      "type": "string",
      "value": "[variables('kvName')]"
    },
    "keyVaultUri": {
      "type": "string",
      "value": "[format('https://{0}{1}/', variables('kvName'), environment().suffixes.keyvaultDns)]"
    },
    "keyVaultResourceId": {
      "type": "string",
      "value": "[resourceId('Microsoft.KeyVault/vaults', variables('kvName'))]"
    }
  }
}